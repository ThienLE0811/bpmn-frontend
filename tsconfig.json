/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@shared/*": ["./src/app/shared/*"],
      "@shared/components": ["./src/app/shared/components/index.ts"],
      "@shared/constants": ["./src/app/shared/constants/index.ts"],
      "@core/*": ["./src/app/core/*"],
      "@core/services": ["./src/app/core/services/index.ts"],
      "@core/models": ["./src/app/core/models/index.ts"],
      "@features/*": ["./src/app/features/*"],
      "@layout/*": ["./src/app/layout/*"],
      "@env/*": ["./src/environments/*"],
      "@env": ["./src/environments/environment.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
